# In Vercel unter Settings → Environment Variables eintragen (nicht ins Repo!)
# Versand über die Brevo-API (kostenlos, 300 Mails/Tag)
# Brevo → Einstellungen → SMTP & API → "API- und MCP-Schlüssel" → Schlüssel erstellen (beginnt mit xkeysib-)
# Brevo → Einstellungen → Sicherheit → Autorisierte IPs: Sperre für API-Schlüssel AUS (Vercel hat wechselnde IPs)
BREVO_API_KEY=xkeysib-...
MAIL_FROM=fssearchfund@gmail.com
MAIL_TO=Info@fs-searchfund.com
ALLOWED_ORIGIN=https://fs-searchfund.com
