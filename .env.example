# In Vercel unter Settings → Environment Variables eintragen (nicht ins Repo!)
# Versand über Gmail (kostenlos): 2-Faktor-Auth aktivieren → myaccount.google.com/apppasswords → App-Passwort erstellen
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=deine.adresse@gmail.com
SMTP_PASS=16-stelliges-app-passwort
SMTP_FROM=deine.adresse@gmail.com
MAIL_TO=Info@fs-searchfund.com
ALLOWED_ORIGIN=https://fs-searchfund.com
